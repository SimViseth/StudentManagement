<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">

    <!-- Appender for general application logs -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/app.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Rotate daily or if larger than 10MB -->
            <fileNamePattern>logs/app.%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <!-- Optional: total size cap for all archived logs -->
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss}] - %level - %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender for exceptions -->
    <appender name="EXCEPTION_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/exception.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Rotate daily or if larger than 10MB -->
            <fileNamePattern>logs/exception.%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss}] - %level - %logger - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- Console output -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss}] - %level - %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Request Logger -->
    <logger name="REQUEST_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="APP_FILE"/>
    </logger>

    <!-- Response Logger -->
    <logger name="RESPONSE_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="APP_FILE"/>
    </logger>

    <!-- Exception Logger -->
    <logger name="EXCEPTION_LOGGER" level="ERROR" additivity="false">
        <appender-ref ref="EXCEPTION_FILE"/>
    </logger>

    <!-- Optional: only keep console logging for root level -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>